# Generated by Cargo
# will have compiled files and executables
debug/
target/

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# rustc will dump stack traces when hitting an internal compiler error to PWD
rustc-ice-*.txt

# Generated by cargo llvm-cov / tarpaulin / grcov
*.profraw
*.profdata
lcov.info
cobertura.xml
tarpaulin-report.html
coverage/

# Generated by cargo-flamegraph / perf
perf.data
perf.data.old
flamegraph.svg

# Environment / secrets
.env
.env.*
!.env.example

# macOS
.DS_Store

# Editors / IDEs
.idea/
*.iml
.vscode/
.vs/
*.swp
*.swo
*~
.helix/
.zed/

# Notes:
# Cargo.lock is tracked on purpose. This is a CLI binary.
# For a library crate, add Cargo.lock to this file instead.
